{
  "name": "finance-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Full-stack personal finance and expense tracker",
  "license": "MIT",
  "author": "Omesh Sachethana",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "dev": "npm run dev -w frontend",
