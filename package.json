{
  "name": "finance-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack personal finance and expense tracker",
  "license": "MIT",
  "author": "Omesh Sachethana",
  "workspaces": [
    "shared",
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "packageManager": "npm@11.6.2"
}
